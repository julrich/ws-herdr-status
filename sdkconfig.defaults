CONFIG_IDF_TARGET="esp32c6"

# The USB-C connector is the only console exposed on this board: GPIO12/13 are
# wired to the native USB-Serial-JTAG peripheral, GPIO16/17 (UART0) are only on
# the 22-pin header. Route the console there so one cable does flash + monitor.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 8 MB flash: the partition table gives the app 6 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# The UI is built from app_main (ui_companion_create), and the kawaii face draws its
# canvases through LVGL's line/fill path while it does so: draw_eye -> lv_canvas_finish_layer
# -> lv_draw_sw_line needs more than the IDF default of 3584 B, which panicked and
# boot-looped the board on 2026-10-02. 8 KB.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- LVGL ---------------------------------------------------------------
# The panel is driven in big-endian RGB565 by the JD9853 SPI driver, but LVGL 9 has
# no CONFIG_LV_COLOR_16_SWAP: the byte order is set on the display instead
# (main.c, flags.swap_bytes). LVGL 9 also allocates through the C library rather
# than a fixed pool, so CONFIG_LV_MEM_SIZE_KILOBYTES is gone with it.
CONFIG_LV_COLOR_DEPTH_16=y

CONFIG_LV_FONT_MONTSERRAT_10=y    # the stats table's rows: see ui_companion.c
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y

CONFIG_LV_USE_ASSERT_NULL=y
CONFIG_LV_USE_ASSERT_MALLOC=y

# --- network ------------------------------------------------------------
# WiFi + the HTTP poller share the heap with LVGL. There is no LVGL pool to trim in
# LVGL 9 — it allocates through the C library (see above) — so the setting that used
# to be trimmed here no longer exists. Note for anyone editing this file: the scanner
# reads "NAME=value" even inside a comment, so naming a symbol that way warns about it.
# CONFIG_ESP_WIFI_ENABLED is a derived symbol (default y on SOC_WIFI_SUPPORTED,
# no prompt) — it cannot be assigned here; it lands in the generated sdkconfig
# automatically.

# No INDEV_DEF_READ_PERIOD: LVGL 9 dropped it and gives every indev its own read timer,
# so assigning it here did nothing (it warns and is ignored). The I2C traffic it was
# meant to reduce is instead governed by the touch driver, which reads only when the
# controller's interrupt says there is a report (AGENTS.md §7).
